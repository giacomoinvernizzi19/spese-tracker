{
  "name": "thinkin-about-money",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "dotenv -o -- npx wrangler deploy",
    "wrangler": "dotenv -o -- npx wrangler",
    "cap:init": "npx cap init \"Thinkin' About Money\" com.thinkinaboutmoney.app --web-dir dist",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "cap:build": "npm run build && npx cap sync",
    "test": "node scripts/test.mjs",
    "db:local": "wrangler d1 migrations apply spese-tracker-db --local",
    "check": "node scripts/astro-security.mjs && astro check && svelte-check --tsconfig ./tsconfig.json",
    "test:d1": "node scripts/test-d1.mjs",
    "smoke:runtime": "node scripts/smoke-runtime.mjs",
    "preflight": "node scripts/preflight.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/svelte": "^7.2.5",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^5.18.2",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "entities": "6.0.1",
    "resend": "^6.26.0",
    "svelte": "^5.57.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/compiler": "2.13.1",
    "@cloudflare/workers-types": "5.20260903.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "22.20.1",
    "dotenv-cli": "^11.0.0",
    "esbuild": "0.28.1",
    "miniflare": "4.20260722.1",
    "svelte-check": "4.7.6",
    "wrangler": "4.115.0"
  },
  "overrides": {
    "wrangler": "$wrangler",
    "miniflare": {
      "undici": "7.29.0"
    },
    "esbuild@0.27.7": "0.28.1"
  }
}
