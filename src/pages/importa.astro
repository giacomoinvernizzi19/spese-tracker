---
import AppLayout from '../layouts/AppLayout.astro';
---

<AppLayout title="Importa Excel" activeNav="settings">
  <div class="bg-white dark:bg-gray-800 rounded-xl p-6 shadow-sm mb-6">
    <h2 class="text-xl font-bold dark:text-gray-100 mb-4">Importa da Excel</h2>

    <!-- Instructions -->
    <div class="bg-blue-50 dark:bg-blue-900/30 border border-blue-200 dark:border-blue-800 rounded-lg p-4 mb-6">
      <h3 class="font-semibold text-blue-800 dark:text-blue-200 mb-2">Formato richiesto</h3>
      <p class="text-blue-700 dark:text-blue-300 text-sm mb-3">
        Il file Excel (.xlsx) deve contenere almeno queste colonne nella prima riga:
      </p>
      <ul class="text-sm text-blue-700 dark:text-blue-300 space-y-1 mb-3">
        <li><strong>Data</strong> - formato: GG/MM/AAAA oppure data Excel</li>
        <li><strong>Importo</strong> - numero (es: 25.50 o 25,50)</li>
        <li><strong>Categoria</strong> - nome categoria (viene creata se non esiste)</li>
        <li><strong>Descrizione</strong> - (opzionale) note sulla spesa</li>
      </ul>
      <p class="text-xs text-blue-600 dark:text-blue-400">
        I nomi delle colonne possono variare (es: "Amount", "$", "Date", etc.) - li mapperai dopo il caricamento
      </p>
    </div>

    <!-- Example -->
    <div class="bg-gray-50 dark:bg-gray-700 rounded-lg p-4 mb-6 overflow-x-auto">
      <h3 class="font-semibold text-gray-700 dark:text-gray-300 mb-2">Esempio struttura file:</h3>
      <table class="text-xs w-full">
        <thead class="bg-gray-200 dark:bg-gray-600">
          <tr>
            <th class="px-3 py-2 text-left dark:text-gray-200">Data</th>
            <th class="px-3 py-2 text-left dark:text-gray-200">Importo</th>
            <th class="px-3 py-2 text-left dark:text-gray-200">Categoria</th>
            <th class="px-3 py-2 text-left dark:text-gray-200">Descrizione</th>
          </tr>
        </thead>
        <tbody class="bg-white dark:bg-gray-800">
          <tr class="border-t dark:border-gray-600">
            <td class="px-3 py-2 dark:text-gray-300">01/01/2024</td>
            <td class="px-3 py-2 dark:text-gray-300">45.90</td>
            <td class="px-3 py-2 dark:text-gray-300">Spesa</td>
            <td class="px-3 py-2 dark:text-gray-300">Supermercato</td>
          </tr>
          <tr class="border-t dark:border-gray-600">
            <td class="px-3 py-2 dark:text-gray-300">02/01/2024</td>
            <td class="px-3 py-2 dark:text-gray-300">12.50</td>
            <td class="px-3 py-2 dark:text-gray-300">Ristoranti</td>
            <td class="px-3 py-2 dark:text-gray-300">Pranzo</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Limitations -->
    <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-lg p-4 mb-6">
      <h3 class="font-semibold text-amber-800 dark:text-amber-200 mb-2">Limitazioni</h3>
      <ul class="text-sm text-amber-700 dark:text-amber-300 space-y-1">
        <li>Vengono importate solo le <strong>spese</strong> (non entrate)</li>
        <li>Le righe senza importo vengono saltate</li>
        <li>Categorie nuove vengono create automaticamente</li>
        <li>Solo la prima scheda (sheet) viene letta</li>
        <li>Massimo ~2000 righe per import</li>
      </ul>
    </div>

    <!-- Upload Area -->
    <div
      id="dropZone"
      class="border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-xl p-8 text-center cursor-pointer hover:border-blue-500 dark:hover:border-blue-400 transition-colors"
    >
      <div class="text-4xl mb-2">&#128194;</div>
      <p class="text-gray-600 dark:text-gray-300">Trascina qui il file Excel</p>
      <p class="text-sm text-gray-400 dark:text-gray-500 mt-1">oppure clicca per selezionare</p>
      <input type="file" id="fileInput" accept=".xlsx,.xls" class="hidden" />
    </div>

    <!-- Preview -->
    <div id="preview" class="hidden mt-6">
      <h3 class="font-semibold dark:text-gray-100 mb-4">Anteprima (<span id="rowCount">0</span> righe)</h3>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-gray-50 dark:bg-gray-700">
            <tr id="previewHeader"></tr>
          </thead>
          <tbody id="previewBody" class="dark:text-gray-300"></tbody>
        </table>
      </div>

      <!-- Column Mapping -->
      <div class="mt-6 grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Colonna Data</label>
          <select id="dateCol" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100"></select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Colonna Importo</label>
          <select id="amountCol" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100"></select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Colonna Categoria</label>
          <select id="categoryCol" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100"></select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Colonna Sottocategoria</label>
          <select id="subCategoryCol" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100">
            <option value="">- Nessuna / Auto-detect -</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Colonna Descrizione</label>
          <select id="descCol" class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100">
            <option value="">- Nessuna -</option>
          </select>
        </div>
      </div>

      <div class="mt-4 bg-gray-50 dark:bg-gray-700 rounded-lg p-3 text-sm text-gray-600 dark:text-gray-300">
        <strong>Sottocategorie:</strong> Se non selezioni, verranno rilevate usando separatori (es: Ristoranti &gt; Pranzo)
      </div>

      <button
        id="importBtn"
        class="w-full mt-6 py-3 bg-blue-600 text-white rounded-xl font-semibold hover:bg-blue-700"
      >
        Importa Spese
      </button>
    </div>

    <!-- Progress -->
    <div id="progress" class="hidden mt-6">
      <div class="flex items-center gap-4">
        <div class="animate-spin w-6 h-6 border-2 border-blue-600 border-t-transparent rounded-full"></div>
        <span>Importazione in corso...</span>
      </div>
      <div class="mt-4 bg-gray-200 rounded-full h-2">
        <div id="progressBar" class="bg-blue-600 h-2 rounded-full transition-all" style="width: 0%"></div>
      </div>
      <p class="text-sm text-gray-500 mt-2"><span id="importedCount">0</span> spese importate</p>
    </div>

    <!-- Success -->
    <div id="success" class="hidden mt-6 text-center">
      <div class="text-4xl mb-2">✅</div>
      <p class="text-lg font-semibold text-green-600">Importazione completata!</p>
      <a href="/" class="text-blue-600 mt-2 inline-block">Vai alla Dashboard →</a>
    </div>
  </div>
</AppLayout>

<script>
  import { displayText, displayColor, displayImage } from '../lib/display';
  import * as XLSX from 'xlsx';
  import { importDigest, importAmount, importDate } from '../lib/import';
  let fileDigest = '';
  let importing = false;
  let fileVersion = 0;

  let parsedData: any[] = [];
  let headers: string[] = [];
  let categories: any[] = [];

  // Load categories
  fetch('/api/categories?hierarchical=true').then(r => r.json()).then(data => categories = data);

  const dropZone = document.getElementById('dropZone')!;
  const fileInput = document.getElementById('fileInput') as HTMLInputElement;

  dropZone.addEventListener('click', () => fileInput.click());
  dropZone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropZone.classList.add('border-blue-500', 'bg-blue-50');
  });
  dropZone.addEventListener('dragleave', () => {
    dropZone.classList.remove('border-blue-500', 'bg-blue-50');
  });
  dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('border-blue-500', 'bg-blue-50');
    const file = e.dataTransfer?.files[0];
    if (file) processFile(file);
  });
  fileInput.addEventListener('change', () => {
    const file = fileInput.files?.[0];
    if (file) processFile(file);
  });

  async function processFile(file: File) {
    if (importing) return;
    const version = ++fileVersion;
    fileDigest = ''; parsedData = []; headers = [];
    document.getElementById('preview')!.classList.add('hidden');
    document.getElementById('success')!.classList.add('hidden');
    try {
      const data = new Uint8Array(await file.arrayBuffer());
      const digest = await importDigest(data);
      const workbook = XLSX.read(data, { type: 'array' });
      const sheet = workbook.Sheets[workbook.SheetNames[0]];
      const json = XLSX.utils.sheet_to_json(sheet, { header: 1 }) as any[][];
      if (version !== fileVersion) return;
      if (json.length < 2) throw new Error('File vuoto o senza dati');
      fileDigest = digest;
      headers = json[0].map(String);
      parsedData = json.slice(1).filter(row => row.some(cell => cell !== undefined && cell !== ''));
      showPreview();
    } catch (error) {
      if (version === fileVersion) alert(error instanceof Error ? error.message : 'File non leggibile');
    }
  }


  // Parse category string to extract parent and subcategory
  function parseCategoryString(categoryStr) {
    const separators = [' > ', ' / ', ' - ', ' : '];
    for (const sep of separators) {
      if (categoryStr.includes(sep)) {
        const parts = categoryStr.split(sep).map(s => s.trim());
        if (parts.length >= 2 && parts[0] && parts[1]) {
          return { parent: parts[0], sub: parts[1] };
        }
      }
    }
    return { parent: categoryStr, sub: null };
  }

  // Find category by name in hierarchical structure
  function findCategoryByName(name, parentId = null) {
    const lowerName = name.toLowerCase();
    for (const cat of categories) {
      if (!parentId && !cat.parent_id && cat.name.toLowerCase() === lowerName) {
        return cat;
      }
      if (cat.children) {
        for (const child of cat.children) {
          if (parentId === cat.id && child.name.toLowerCase() === lowerName) {
            return child;
          }
        }
      }
    }
    return null;
  }

  // Find or create category
  async function findOrCreateCategory(name, parentId = null) {
    let category = findCategoryByName(name, parentId);
    if (category) return { category, created: false };

    const res = await fetch('/api/categories', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, parent_id: parentId })
    });
    const newCat = await res.json();
    if (!res.ok) throw new Error(newCat.error || 'Categoria non salvata');
    const created = { id: newCat.id, name, parent_id: parentId, children: [] };
    
    if (parentId) {
      const parent = categories.find(c => c.id === parentId);
      if (parent) {
        if (!parent.children) parent.children = [];
        parent.children.push(created);
      }
    } else {
      categories.push(created);
    }
    return { category: created, created: true };
  }

  function showPreview() {
    document.getElementById('preview')!.classList.remove('hidden');
    document.getElementById('rowCount')!.textContent = parsedData.length.toString();

    // Header
    document.getElementById('previewHeader')!.innerHTML = headers
      .map(h => `<th class="px-3 py-2 text-left">${displayText(h)}</th>`).join('');

    // Body (first 5 rows)
    document.getElementById('previewBody')!.innerHTML = parsedData.slice(0, 5)
      .map(row => `<tr>${headers.map((_, i) => `<td class="px-3 py-2 border-t">${displayText(row[i] ?? '')}</td>`).join('')}</tr>`)
      .join('');

    // Populate column selectors
    const options = headers.map((h, i) => `<option value="${i}">${displayText(h)}</option>`).join('');
    ['dateCol', 'amountCol', 'categoryCol'].forEach(id => {
      document.getElementById(id)!.innerHTML = options;
    });
    document.getElementById('subCategoryCol')!.innerHTML = `<option value="">- Nessuna / Auto-detect -</option>${options}`;
    document.getElementById('descCol')!.innerHTML = `<option value="">- Nessuna -</option>${options}`;

    // Auto-detect columns
    const lowerHeaders = headers.map(h => h.toLowerCase());
    const dateIdx = lowerHeaders.findIndex(h => h.includes('data') || h.includes('date'));
    const amountIdx = lowerHeaders.findIndex(h => h.includes('importo') || h.includes('amount') || h === '$');
    const catIdx = lowerHeaders.findIndex(h => h.includes('categoria') || h.includes('category'));
    const subCatIdx = lowerHeaders.findIndex(h => h.includes('sottocategoria') || h.includes('subcategory') || h.includes('sub-category'));
    const descIdx = lowerHeaders.findIndex(h => h.includes('desc') || h.includes('note') || h.includes('item'));

    if (dateIdx >= 0) (document.getElementById('dateCol') as HTMLSelectElement).value = dateIdx.toString();
    if (amountIdx >= 0) (document.getElementById('amountCol') as HTMLSelectElement).value = amountIdx.toString();
    if (catIdx >= 0) (document.getElementById('categoryCol') as HTMLSelectElement).value = catIdx.toString();
    if (subCatIdx >= 0) (document.getElementById('subCategoryCol') as HTMLSelectElement).value = subCatIdx.toString();
    if (descIdx >= 0) (document.getElementById('descCol') as HTMLSelectElement).value = descIdx.toString();
  }

  document.getElementById('importBtn')?.addEventListener('click', async () => {
    if(importing || !fileDigest) return;
    importing=true;
    const button=document.getElementById('importBtn') as HTMLButtonElement;
    button.disabled=true;
    const column=(id:string)=>(document.getElementById(id) as HTMLSelectElement).value;
    const mapping={date:column('dateCol'),amount:column('amountCol'),category:column('categoryCol'),sub:column('subCategoryCol'),description:column('descCol')};
    const errors:string[]=[];
    let imported=0,duplicates=0;
    try {
      const batch=fileDigest;
      document.getElementById('progress')!.classList.remove('hidden');
      for(const [index,row] of parsedData.entries()) {
        try {
          const amount=importAmount(row[Number(mapping.amount)]),date=importDate(row[Number(mapping.date)]);
          const rawCategory=String(row[Number(mapping.category)] ?? '').trim();
          if(!rawCategory) throw new Error('Categoria mancante');
          const rawSub=mapping.sub ? String(row[Number(mapping.sub)] ?? '').trim() : '';
          const parsed=rawSub ? {parent:rawCategory,sub:rawSub} : parseCategoryString(rawCategory);
          const {category:parent}=await findOrCreateCategory(parsed.parent,null);
          const category=parsed.sub ? (await findOrCreateCategory(parsed.sub,parent.id)).category : parent;
          const response=await fetch('/api/transactions',{
            method:'POST',headers:{'Content-Type':'application/json'},
            body:JSON.stringify({amount,date,type:'expense',category_id:category.id,description:mapping.description ? String(row[Number(mapping.description)] ?? '') : '',source:'import',import_batch_id:batch,import_row_id:index})
          });
          const result=await response.json();
          if(!response.ok) throw new Error(result.error || 'Riga non salvata');
          if(result.duplicate) duplicates++; else imported++;
        } catch(error) {
          errors.push(`Riga dati ${index+1}: ${error instanceof Error ? error.message : 'Errore imprevisto'}`);
        }
        document.getElementById('importedCount')!.textContent=String(imported);
        (document.getElementById('progressBar') as HTMLElement).style.width=`${((index+1)/parsedData.length)*100}%`;
      }
      const result=document.getElementById('success')!;
      result.classList.remove('hidden');
      result.querySelector('p')!.textContent=`${imported} righe importate, ${duplicates} già presenti, ${errors.length} rifiutate.`;
      let details=document.getElementById('importErrors');
      if(!details){details=document.createElement('pre');details.id='importErrors';details.className='whitespace-pre-wrap text-sm text-red-600 text-left';result.append(details);}
      details.textContent=errors.join('\n');
      button.textContent=errors.length?'Riprova righe non importate':'Importa';
    } catch(error){ alert(error instanceof Error?error.message:'Importazione non riuscita'); }
    finally { importing=false;button.disabled=false;document.getElementById('progress')!.classList.add('hidden'); }
  });
</script>
